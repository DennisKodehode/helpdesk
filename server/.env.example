DATABASE_URL=postgresql://postgres:postgres@localhost:5432/helpdesk
BETTER_AUTH_SECRET=change-me-to-a-random-secret
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated list of allowed client origins (CORS + Better Auth trustedOrigins).
# Add LAN IPs for testing on a phone, e.g. http://localhost:5173,http://192.168.x.x:5173
CLIENT_URL=http://localhost:5173
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-to-a-strong-password
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=support@yourdomain.com
GOOGLE_GENERATIVE_AI_API_KEY=your-key-here
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# Attachment storage. Dev defaults to local filesystem (server/.attachments/).
# In prod, point at an S3-compatible bucket. Railway Buckets and Cloudflare R2
# are both $0.015/GB-mo with free egress and a 10 GB free allowance.
STORAGE_DRIVER=local
# Required when STORAGE_DRIVER=s3 (values below are from the bucket's credentials):
# S3_ENDPOINT=https://storage.railway.app        # R2: https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=helpdesk-attachments-<hash>
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# Virtual-hosted-style is the default (Railway/R2/AWS). Set "true" only for
# path-style providers like a local MinIO.
# S3_FORCE_PATH_STYLE=false
