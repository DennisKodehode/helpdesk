generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  agent
}

enum TicketStatus {
  new
  processing
  open
  resolved
  closed
}

enum TicketCategory {
  general_question
  technical_question
  refund_request
  billing_inquiry
  feature_request
}

enum TicketPriority {
  low
  normal
  high
  urgent
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  role          Role      @default(agent)
  deletedAt     DateTime?
  sessions             Session[]
  accounts             Account[]
  assignedTickets      Ticket[]
  replies              Reply[]
  notifications        Notification[] @relation("NotificationRecipient")
  triggeredNotifications Notification[] @relation("NotificationActor")

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

enum SenderType {
  agent
  customer
  internal_note
}

model Ticket {
  id                 Int      @id @default(autoincrement())
  fromName           String
  fromEmail          String
  subject            String
  body               String
  bodyHtml           String?
  status             TicketStatus   @default(new)
  category           TicketCategory?
  priority           TicketPriority @default(normal)
  assignedToId       String?
  assignedTo         User?    @relation(fields: [assignedToId], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  resolvedAt         DateTime?
  closedAt           DateTime?
  firstAgentReplyAt  DateTime?
  resendEmailId      String?  @unique
  replies            Reply[]
  notifications      Notification[]

  @@index([status, createdAt])
  @@index([assignedToId, status])
  @@index([fromEmail, subject, status])
  @@index([status, resolvedAt])
  @@map("ticket")
}

model Reply {
  id            Int       @id @default(autoincrement())
  ticketId      Int
  ticket        Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId      String?
  author        User?     @relation(fields: [authorId], references: [id])
  senderType    SenderType @default(agent)
  body          String
  bodyHtml      String?
  resendEmailId String?   @unique
  createdAt     DateTime  @default(now())

  @@index([ticketId, createdAt])
  @@index([authorId, senderType])
  @@map("reply")
}

enum SuppressionReason {
  hard_bounce
  complaint
  manual
}

model EmailSuppression {
  id            String            @id @default(cuid())
  email         String            @unique
  reason        SuppressionReason
  detail        String?
  resendEmailId String?
  createdAt     DateTime          @default(now())

  @@map("email_suppression")
}

enum NotificationType {
  customer_reply
  ticket_assigned
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  type      NotificationType
  ticketId  Int
  ticket    Ticket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
  @@map("notification")
}
