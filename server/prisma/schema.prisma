generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  agent
}

enum UserStatus {
  invited
  active
  inactive
}

enum TicketStatus {
  new
  processing
  open
  resolved
  closed
}

enum TicketCategory {
  general_question
  technical_question
  refund_request
  billing_inquiry
  feature_request
}

enum TicketPriority {
  low
  normal
  high
  urgent
}

enum AutoAssignMode {
  round_robin
  least_loaded
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  role          Role      @default(agent)
  status        UserStatus @default(active)
  deletedAt     DateTime?
  sessions             Session[]
  accounts             Account[]
  assignedTickets      Ticket[]
  replies              Reply[]
  notifications        Notification[] @relation("NotificationRecipient")
  triggeredNotifications Notification[] @relation("NotificationActor")
  auditEvents          AuditEvent[]   @relation("AuditEventActor")
  invitation           Invitation?

  @@map("user")
}

// One pending invite per user. The raw token lives only in the emailed link;
// we store its SHA-256 hash, so a DB leak can't be replayed. Single-use: the
// row is deleted on accept, and resend rotates the hash (invalidating old links).
model Invitation {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([tokenHash])
  @@map("invitation")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

enum SenderType {
  agent
  customer
  internal_note
}

model Ticket {
  id                 Int      @id @default(autoincrement())
  fromName           String
  fromEmail          String
  subject            String
  body               String
  bodyHtml           String?
  status             TicketStatus   @default(new)
  category           TicketCategory?
  priority           TicketPriority @default(normal)
  assignedToId       String?
  assignedTo         User?    @relation(fields: [assignedToId], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  resolvedAt         DateTime?
  closedAt           DateTime?
  firstAgentReplyAt  DateTime?
  lastReplySenderType SenderType?
  resendEmailId      String?  @unique
  replies            Reply[]
  notifications      Notification[]
  auditEvents        AuditEvent[]
  attachments        Attachment[]

  @@index([status, createdAt])
  @@index([assignedToId, status])
  @@index([fromEmail, subject, status])
  @@index([status, resolvedAt])
  @@index([status, lastReplySenderType])
  @@map("ticket")
}

model Reply {
  id            Int       @id @default(autoincrement())
  ticketId      Int
  ticket        Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId      String?
  author        User?     @relation(fields: [authorId], references: [id])
  senderType    SenderType @default(agent)
  body          String
  bodyHtml      String?
  resendEmailId String?   @unique
  createdAt     DateTime  @default(now())
  attachments   Attachment[]

  @@index([ticketId, createdAt])
  @@index([authorId, senderType])
  @@map("reply")
}

model Attachment {
  id          String   @id @default(cuid())
  // Polymorphic parent: exactly ONE of replyId or ticketId is set, enforced
  // at the DB level via the attachment_xor_parent CHECK constraint added in
  // the corresponding migration (raw SQL — Prisma doesn't model CHECK
  // constraints natively).
  replyId     Int?
  reply       Reply?   @relation(fields: [replyId], references: [id], onDelete: Cascade)
  ticketId    Int?
  ticket      Ticket?  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  filename    String
  contentType String
  size        Int
  storageKey  String   @unique
  createdAt   DateTime @default(now())

  @@index([replyId])
  @@index([ticketId])
  @@map("attachment")
}

enum SuppressionReason {
  hard_bounce
  complaint
  manual
}

model EmailSuppression {
  id            String            @id @default(cuid())
  email         String            @unique
  reason        SuppressionReason
  detail        String?
  resendEmailId String?
  createdAt     DateTime          @default(now())

  @@map("email_suppression")
}

enum NotificationType {
  customer_reply
  ticket_assigned
  sla_breach_warning
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  type      NotificationType
  ticketId  Int
  ticket    Ticket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
  @@map("notification")
}

model SlaPolicy {
  priority             TicketPriority @id
  firstResponseMinutes Int?
  resolutionMinutes    Int?
  updatedAt            DateTime       @updatedAt

  @@map("sla_policy")
}

// Singleton row (id always "default") holding the admin-configurable
// ticket-lifecycle rules edited on the Workflow screen. `roundRobinCursor` is
// internal auto-assign state, never exposed through the API contract.
model WorkflowSettings {
  id                   String         @id @default("default")
  autoAssignOn         Boolean        @default(false)
  autoAssignMode       AutoAssignMode @default(round_robin)
  autoResolveOn        Boolean        @default(true)
  autoResolveThreshold Int            @default(85)
  requireCategory      Boolean        @default(true)
  requireAssignee      Boolean        @default(false)
  autoCloseOn          Boolean        @default(true)
  autoCloseDays        Int            @default(7)
  reopenOnReply        Boolean        @default(true)
  lockClosed           Boolean        @default(true)
  slaGreenMin          Int            @default(90)
  slaYellowMin         Int            @default(60)
  roundRobinCursor     Int            @default(0)
  updatedAt            DateTime       @updatedAt

  @@map("workflow_settings")
}

enum AuditEventType {
  status_changed
  assignee_changed
  priority_changed
  category_changed
  reply_added
  ticket_created
  auto_resolved
  ai_escalated
  auto_reopened
  auto_closed
}

model AuditEvent {
  id        String         @id @default(cuid())
  ticketId  Int
  ticket    Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?          @relation("AuditEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  type      AuditEventType
  data      Json?
  createdAt DateTime       @default(now())

  @@index([ticketId, createdAt])
  // Global activity log (admin): newest-first scans + date-range filtering.
  @@index([createdAt])
  // Primary "investigate one actor over time" filter for the activity log.
  @@index([actorId, createdAt])
  @@map("audit_event")
}
