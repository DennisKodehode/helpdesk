{
  "name": "helpdesk",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "core"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "typecheck": "bun run --filter '*' typecheck && tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "test:e2e": "bun --env-file server/.env.test playwright test --pass-with-no-tests",
    "test:e2e:ui": "bun --env-file server/.env.test playwright test --ui"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3"
  }
}
